PORT=4001
DATABASE_URL=postgres://postgres:postgres@localhost:5434/api_monitoring
REDIS_URL=redis://localhost:6379

# Optional — get one free at aistudio.google.com. Without it (or if the API
# call fails), the chat assistant falls back to its built-in rule-based engine
# automatically.
GEMINI_API_KEY=

# Auto-detection: consecutive failed checks before an incident opens, and
# consecutive passing checks before it auto-resolves.
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_RECOVERY_THRESHOLD=2

# Kubernetes/OpenShift remediation (rollout restart, scale). Off unless enabled.
# In-cluster it uses the pod's ServiceAccount; outside, set the API URL and a
# token (e.g. `oc whoami -t`). K8S_CA_CERT is a path to the cluster CA bundle.
K8S_REMEDIATION_ENABLED=false
K8S_API_URL=
K8S_TOKEN=
K8S_CA_CERT=
K8S_DEFAULT_NAMESPACE=production-apps
K8S_MAX_REPLICAS=10
